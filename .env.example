# 复制为 .env 后按需修改。不要提交真实密钥。
# linknote 只读取下面列出的变量，不会读取你其他项目的配置。

# ---- 输出 ----
# 默认输出目录（CLI 的 --output 会覆盖它）
LINKNOTE_OUTPUT=./linknote-notes
# 是否长期保留原视频/原始媒体（默认 false，ASR 完成后删除音频）
LINKNOTE_KEEP_MEDIA=false

# ---- 转写（可选）----
# 不配置时：抖音只能拿到视频元信息，无法获得口播内容，未取得口播时状态为 failed
# 兼容 OpenAI /audio/transcriptions 形态的服务
LINKNOTE_ASR_PROVIDER=siliconflow
LINKNOTE_ASR_BASE_URL=https://api.siliconflow.cn/v1
LINKNOTE_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
LINKNOTE_ASR_API_KEY=

# ---- 摘要模型（可选）----
# 不配置时：摘要与关键观点使用“抽取式”算法（机械抽取，非模型生成），笔记里会标注
LINKNOTE_LLM_BASE_URL=
LINKNOTE_LLM_MODEL=
LINKNOTE_LLM_API_KEY=

# ---- 网络 ----
LINKNOTE_HTTP_TIMEOUT=30
LINKNOTE_RETRIES=2

# ---- 抖音 ----
# 抖音接口有签名校验，必须用真实浏览器上下文取数据
LINKNOTE_DOUYIN_HEADLESS=true
# 复用你已登录的 Chrome（debug 端口），留空表示用 Playwright 自带 chromium
LINKNOTE_DOUYIN_CDP_URL=

# ---- 输出风格 ----
# plain（默认，任何 Markdown 编辑器都能看）/ obsidian（用 [!warning] 之类 callout）
LINKNOTE_DIALECT=plain
# 是否写 YAML frontmatter；导入 Notion / Word 时可设 false
LINKNOTE_FRONTMATTER=true
